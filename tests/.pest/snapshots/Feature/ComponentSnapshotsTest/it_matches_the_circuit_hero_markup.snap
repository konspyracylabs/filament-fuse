<div class="fuse-panel fuse-hero"  wire:poll.5s >
            <div class="fuse-hero__body">
            <div class="fuse-orb-ctn">
    <div class="fuse-orb__ring" aria-hidden="true"></div>

    <div class="fuse-orb fuse-orb--open">
        <div class="fuse-orb__state">Open</div>
        <div class="fuse-label">stripe</div>
    </div>
</div>

            <div class="fuse-hero__side">
                                    <div class="fuse-tile__duration fuse-hero__duration">Open for 4m 12s</div>
                
                <div class="fuse-hero__facts">
                    <div>
                        <div class="fuse-label">Next probe</div>
                        <div class="fuse-mono fuse-hero__fact-value">in 0:48</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="fuse-metrics">
                            <div class="fuse-metric fuse-metric--cyan">
    <div class="fuse-label">Attempts</div>
    <div class="fuse-metric__value">38</div>

            <div class="fuse-metric__caption">in current window</div>
    </div>
                            <div class="fuse-metric fuse-metric--open">
    <div class="fuse-label">Failures</div>
    <div class="fuse-metric__value">27</div>

            <div class="fuse-metric__caption">in current window</div>
    </div>
                            <div class="fuse-metric fuse-metric--open">
    <div class="fuse-label">Failure rate</div>
    <div class="fuse-metric__value">71%</div>

            <div class="fuse-metric__caption">threshold: 50%</div>
    </div>
                            <div class="fuse-metric fuse-metric--half-open">
    <div class="fuse-label">Min requests</div>
    <div class="fuse-metric__value">5</div>

            <div class="fuse-metric__caption">before evaluation</div>
    </div>
                    </div>
    </div>
